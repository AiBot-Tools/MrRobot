# aos-kernel credentials: TEMPLATE. Placeholders only, never a real value.
#
# This file is committed (the repository is public) and does not change when
# your live .env does. Your real values go in .env, next to this file, which
# git ignores. npm run aos-install, run from the repository root, makes it:
# it creates .env at mode 0600 when it is missing, or appends the token names
# it lacks, each a value it generates. It never changes a line, never prints a
# value, and never writes ANTHROPIC_API_KEY, which you add. To make it by hand
# instead, create it without overwriting one, at mode 0600 (the kernel refuses
# anything looser), then replace every replace-me-... value in a plain-text
# editor:
#
#   test -e .env || (umask 077 && cp .env.example .env)
#   chmod 600 .env
#
# npm run aos-install never changes a line, so it refuses a .env that still
# holds a placeholder. For AOS_PMMCP_TOKEN, either delete its line, and
# npm run aos-install then appends it, or put in a value of your own
# (openssl rand -hex 32), whose digest npm run aos-install then stages.
#
# npm run dev reads all three names; npm run cli and npm run eval read only
# AOS_CONTROL_TOKEN; npm test reads none (the live tests read
# ANTHROPIC_API_KEY, with AOS_LIVE_TESTS=1). A value exported in your shell
# wins over the file unless it is blank. The kernel refuses to start while a
# value still begins with replace-me, and refuses a .env that is a symlink, has
# a mode letting group or others read it, or is no longer git-ignored. Only the
# names below are accepted; any other line is refused.

# Control-plane bearer, at least 32 characters. Generate: openssl rand -hex 32
# Not a lowercase hex value shorter than 64 characters (openssl rand -hex 16
# makes one): that is what a write npm run aos-install did not finish leaves,
# so it refuses such a value of either token as cut short, by its line.
AOS_CONTROL_TOKEN=replace-me-with-openssl-rand-hex-32

# pmmcp bearer for client aos-kernel (kernel.yaml mcp.servers.pmmcp.tokenEnv).
# npm run aos-install generates it and gives pmmcp only its sha256 digest.
AOS_PMMCP_TOKEN=replace-me-with-npm-run-aos-install

# Anthropic API key (config/providers.yaml anthropic/claude-sonnet-5, auth.envVar).
# Create it inside a workspace in the Claude Console: an unscoped key is refused
# with HTTP 400 unless each request carries anthropic-workspace-id, which the
# kernel does not send.
ANTHROPIC_API_KEY=replace-me-with-your-anthropic-api-key
