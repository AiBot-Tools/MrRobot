# aos-kernel credentials: TEMPLATE. Placeholders only, never a real value.
#
# This file is committed (the repository is public) and does not change when
# your live .env does. Your real values go in .env, next to this file, which
# git ignores and only you write. Create it without overwriting one, at mode
# 0600 (the kernel refuses anything looser), then replace every replace-me-...
# value in a plain-text editor:
#
#   test -e .env || (umask 077 && cp .env.example .env)
#   chmod 600 .env
#
# npm run dev reads both names; npm run cli and npm run eval read only
# AOS_CONTROL_TOKEN; npm test reads neither (the live tests do, with
# AOS_LIVE_TESTS=1). A value exported in your shell wins over the file unless
# it is blank. The kernel refuses to start while a value still begins with
# replace-me, and refuses a .env that is a symlink, has a mode letting group or
# others read it, or is no longer git-ignored. Only the names below are
# accepted; any other line is refused.

# Control-plane bearer, at least 32 characters. Generate: openssl rand -hex 32
AOS_CONTROL_TOKEN=replace-me-with-openssl-rand-hex-32

# Anthropic API key (config/providers.yaml anthropic/claude-sonnet-5, auth.envVar).
ANTHROPIC_API_KEY=replace-me-with-your-anthropic-api-key
