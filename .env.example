# aos-kernel environment contract — NAMES ONLY.
# No value in this file is ever a real credential. Copy to .env and fill locally:
#   cp .env.example .env && set -a && . ./.env && set +a
# .env is gitignored. A secret must never be written into a file under this repo.

# Required. The control plane refuses to boot without it, and refuses a value
# shorter than 32 characters after trimming. Generate with: openssl rand -hex 32
AOS_CONTROL_TOKEN=

# Optional. Defaults to ~/.aos, created 0700. Must resolve outside this repo.
# Holds events.db, events.head, probes/ and workspaces/.
AOS_DATA_DIR=

# Optional. pino level; defaults to info.
AOS_LOG_LEVEL=

# Optional. Bearer token for pmmcp. Without it the MCP hub boots degraded.
# The pmmcp URL itself lives in config/kernel.yaml: a URL is config, not a secret.
PMMCP_TOKEN=

# Optional, and read by the secrets broker ONLY when that provider entry's vault
# path failed AND kernel.yaml secrets.envFallback is true (default false).
# The vault is the primary store; these names are a per-entry secondary.
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
MOONSHOT_API_KEY=
LLAMA_API_KEY=

# Optional, test-only. Set to 1 to enable the two gated network tests.
AOS_LIVE_TESTS=
# Test-only, never read by src/. Must be loopback.
PMMCP_URL=

# DOCKER_HOST is deliberately absent: it is never read. Each sandbox domain's
# socket is explicit in kernel.yaml and passed in the spawn environment.
